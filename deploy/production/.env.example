# Copy to deploy/production/.env on the VPS, fill in real values there, then chmod 600 it.
# This file contains placeholders only and must stay safe to commit.

# Public URLs and TLS certificate contact
FRONTEND_ORIGIN=https://atethat.architsangal.in
CADDY_EMAIL=admin@architsangal.in

# MongoDB Atlas (database user must have access only to this database)
MONGODB_URI=mongodb+srv://REPLACE_WITH_ATLAS_USER:REPLACE_WITH_ATLAS_PASSWORD@REPLACE_WITH_CLUSTER/atethat?retryWrites=true&w=majority
MONGODB_DATABASE=atethat

# Transactional email (Gmail SMTP is appropriate only for initial low volume)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=REPLACE_WITH_GMAIL_ADDRESS
SMTP_PASSWORD=REPLACE_WITH_GMAIL_APP_PASSWORD
SMTP_FROM=AteThat <REPLACE_WITH_GMAIL_ADDRESS>

# Google OAuth. Register the production origin and callback before enabling sign-in.
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=https://api.atethat.architsangal.in/api/v1/auth/google/callback

# USDA: create a personal key; do not use DEMO_KEY in production.
USDA_API_KEY=REPLACE_WITH_USDA_API_KEY

# Generate fresh values directly on the VPS; do not copy development signing material.
API_VERIFY_PUBLIC_KEY_B64=REPLACE_WITH_ED25519_PUBLIC_KEY_BASE64
CORE_SIGNING_SEED_B64=REPLACE_WITH_ED25519_SEED_BASE64
INTERNAL_SERVICE_SECRET_B64=REPLACE_WITH_32_OR_MORE_RANDOM_BYTES_BASE64
