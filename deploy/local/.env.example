# Illustrative names only. Run `make local-config` to create real random local secrets.
CORE_SIGNING_SEED_B64=<random-32-byte-base64-seed>
API_VERIFY_PUBLIC_KEY_B64=<corresponding-ed25519-public-key-base64>
INTERNAL_SERVICE_SECRET_B64=<random-32-byte-base64-secret>
FRONTEND_ORIGIN=http://localhost:5173
SMTP_FROM=atethat@localhost
# Optional only after creating a Google OAuth client:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:18080/api/v1/auth/google/callback
# Optional. DEMO_KEY permits only a small number of USDA calls; use your own key for testing.
USDA_API_KEY=DEMO_KEY
